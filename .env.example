# Copy to .env.local (never commit real values). Server-only: none of these may be exposed to clients.

# Supabase pooler connection string, transaction mode (port 6543), from
# Supabase Dashboard -> Connect -> "Transaction pooler". Contains the DB password.
DATABASE_URL=postgresql://postgres.xeqhygypqyyyoortalod:<db-password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# PEM of the Supabase root CA (Dashboard -> Database -> SSL configuration) to verify TLS.
# Without it TLS is still used, but the server certificate is not verified.
DATABASE_CA_CERT=

# Max pooled connections per server instance (keep small; Supavisor multiplexes).
DATABASE_POOL_MAX=5

# --- Authentication (email OTP, FiNN-issued tokens) ---
# Random secret, at least 32 chars (e.g. `openssl rand -base64 48`). Signs access tokens and keys
# the hashes of sign-in codes and refresh tokens. Changing it signs everyone out.
AUTH_JWT_SECRET=
# Access token lifetime in seconds (default 900), refresh token lifetime in days (default 30),
# sign-in code lifetime in seconds (default 600).
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_OTP_TTL_SECONDS=600

# --- Outgoing email (nodemailer over SMTP; Gmail by default) ---
# For Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters into SMTP_PASS.
SMTP_HOST=smtp.gmail.com
# 465 = implicit TLS (SMTP_SECURE defaults to true); 587 = STARTTLS.
SMTP_PORT=465
SMTP_USER=finn.team007@gmail.com
SMTP_PASS=
MAIL_FROM=FiNN <finn.team007@gmail.com>

# Comma-separated browser origins allowed by CORS (only needed for Flutter web).
CORS_ORIGINS=

# --- Agent LLM relay (POST /api/v1/agent/completions) ---
# Groq API key (server-only secret, from https://console.groq.com/keys). Leave empty to disable
# the assistant: the relay then answers 503 `unavailable` ("not configured") and the rest of the
# API works normally.
GROQ_API_KEY=
# Groq OpenAI-compatible base URL (default https://api.groq.com/openai/v1).
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Model the server always uses; clients cannot choose it (default openai/gpt-oss-20b).
GROQ_MODEL=openai/gpt-oss-20b
# reasoning_effort sent upstream: off | none | default | low | medium | high (default low).
# `off` = the parameter is not sent (for models that do not support it).
GROQ_REASONING_EFFORT=low
# Upstream timeout in milliseconds (default 60000, 100..300000).
GROQ_TIMEOUT_MS=60000
# Ceiling and default for max_completion_tokens (default 2048).
AGENT_MAX_OUTPUT_TOKENS=2048
# Per-user request limits (in-memory, per server instance: serverless instances do not share them).
AGENT_RATE_LIMIT_PER_MINUTE=20
AGENT_DAILY_REQUEST_LIMIT=300
